# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Opta scraper dumps
/output/

# Local / debug / bulk dumps (not for deploy)
.cursor/
debug-*.log
/data/Round */
/data/extracted/
/Teams Color/

# Runtime store — production uses Vercel Blob; keep local copy out of git
/data/store.json

.vercel
.env*.local
